# ════════════════════════════════════════════════════════════════
#  DinoVerse — env template. Copy to `.env` (and `apps/web/.env`)
#  and fill in your values. Never commit the filled file.
#  See DEPLOY.md for which subset each host needs.
# ════════════════════════════════════════════════════════════════

# ─── Multiplayer (Colyseus on Railway) ───────────────────────────
# Public WebSocket URL of the race server. In dev: ws://localhost:2567.
# In production (Vercel + Railway): wss://<your-railway-service>.up.railway.app
# REQUIRED for the live Dino Dash launch. Web client falls back to
# window.location.hostname:2567 if this is unset (LAN dev only).
NEXT_PUBLIC_COLYSEUS_URL="ws://localhost:2567"

# ─── Database (Neon) ─────────────────────────────────────────────
# Only required if you turn on logged-in profiles + parental dashboard.
# Dino Dash standalone runs on localStorage and doesn't need this.
# Pooled connection string for app runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# Direct (unpooled) connection for migrations (root .env only)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# ─── Auth (Better Auth) ──────────────────────────────────────────
# Only required if you turn on logged-in profiles.
BETTER_AUTH_SECRET="generate-a-long-random-string"
# In dev: http://localhost:3000. In prod: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# ─── Cloudflare (Stream video + R2 storage) ──────────────────────
# Only required when video / asset features go live.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""

# ─── Email (Resend) ──────────────────────────────────────────────
# Only required if auth + email verification are on.
RESEND_API_KEY=""
# onboarding@resend.dev works for testing to your own account email only.
EMAIL_FROM="DinoVerse <onboarding@resend.dev>"
