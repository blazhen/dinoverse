# ─── Database (Neon) ─────────────────────────────────────────────
# Pooled connection string for app runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# Direct (unpooled) connection for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# ─── Auth (Better Auth) ──────────────────────────────────────────
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Cloudflare (Stream video + R2 storage) ──────────────────────
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ─── Multiplayer (Colyseus on Railway) ───────────────────────────
# Public URL of the Colyseus server the clients connect to
NEXT_PUBLIC_COLYSEUS_URL="ws://localhost:2567"

# ─── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=""
# onboarding@resend.dev works for testing to your own account email only.
EMAIL_FROM="DinoVerse <onboarding@resend.dev>"
